<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="680"
        x:Class="ScrapMechanicModManager.Desktop.MainWindow"
        Title="Scrap Mechanic Mod Manager"
        Icon="avares://ScrapMechanicModManager/Assets/ScrapMechanicModManager.png"
        Width="960"
        Height="760"
        MinWidth="780"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Window.Styles>

  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock x:Name="HeaderText"
                   FontSize="28"
                   FontWeight="Bold" />
        <TextBlock x:Name="SubtitleText"
                   Opacity="0.72" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Top">
        <TextBlock x:Name="LanguageLabelText"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="LanguageComboBox"
                  Width="130"
                  SelectionChanged="OnLanguageChanged" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <TextBlock Grid.Column="0"
                 x:Name="GameRootLabelText"
                 VerticalAlignment="Center"
                 Classes="sectionTitle" />
      <TextBox Grid.Column="1"
               x:Name="GameRootTextBox" />
      <Button Grid.Column="2"
              x:Name="BrowseButton"
              Click="OnBrowseClick" />
    </Grid>

    <Border Grid.Row="2"
            Padding="14"
            CornerRadius="8"
            Background="#12000000"
            BorderBrush="#26000000"
            BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock x:Name="GameStatusText" />
        <TextBlock x:Name="ModStatusText" />
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Padding="14"
            CornerRadius="8"
            Background="#0A000000"
            BorderBrush="#20000000"
            BorderThickness="1">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnDefinitions="*,Auto,Auto"
            RowSpacing="7"
            ColumnSpacing="18">
        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   x:Name="ModulesLabelText"
                   Classes="sectionTitle" />
        <CheckBox Grid.Row="1"
                  Grid.Column="0"
                  x:Name="RobotLootModuleCheckBox"
                  Click="OnModuleSelectionChanged" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   x:Name="RobotLootModuleStatusText"
                   Opacity="0.68" />
        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   x:Name="RobotLootBackupStatusText"
                   Opacity="0.68" />
        <CheckBox Grid.Row="2"
                  Grid.Column="0"
                  x:Name="BeehiveAutomationModuleCheckBox"
                  Click="OnModuleSelectionChanged" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   x:Name="BeehiveAutomationModuleStatusText"
                   Opacity="0.68" />
        <TextBlock Grid.Row="2"
                   Grid.Column="2"
                   x:Name="BeehiveAutomationBackupStatusText"
                   Opacity="0.68" />
        <CheckBox Grid.Row="3"
                  Grid.Column="0"
                  x:Name="FreezerAutomationModuleCheckBox"
                  Click="OnModuleSelectionChanged" />
        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   x:Name="FreezerAutomationModuleStatusText"
                   Opacity="0.68" />
        <TextBlock Grid.Row="3"
                   Grid.Column="2"
                   x:Name="FreezerAutomationBackupStatusText"
                   Opacity="0.68" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                Spacing="9">
      <Button x:Name="CheckButton"
              Click="OnCheckClick" />
      <Button x:Name="InstallButton"
              Click="OnInstallClick" />
      <Button x:Name="RestoreButton"
              Click="OnRestoreClick" />
      <Button x:Name="LaunchButton"
              Click="OnLaunchClick" />
      <CheckBox x:Name="DevModeCheckBox"
                VerticalAlignment="Center" />
    </StackPanel>

    <ProgressBar Grid.Row="5"
                 x:Name="ProgressBar"
                 IsIndeterminate="True"
                 IsVisible="False"
                 Height="4" />

    <TextBox Grid.Row="6"
             x:Name="LogTextBox"
             AcceptsReturn="True"
             IsReadOnly="True"
             TextWrapping="NoWrap"
             FontFamily="monospace"
             FontSize="13"
             Background="#1C1F24"
             Foreground="#E5E9EC"
             BorderBrush="#343A40"
             BorderThickness="1"
             Padding="10"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" />

    <TextBlock Grid.Row="7"
               x:Name="FooterText"
               HorizontalAlignment="Right"
               Opacity="0.55"
               FontSize="12" />
  </Grid>
</Window>
