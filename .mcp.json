                                                     "-y",
                                                     "@bitbonsai/mcpvault@latest",
                                                     "E:/Repos/obsidian-vault"
                                                 ]
                                    },
                       "smart-connections":  {
                                                 "command":  "cmd",
                                                 "args":  [
                                                              "/c",
